{
  "name": "jmap-lib",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript JMAP library with typed protocol methods, convenience clients, and real-server integration tests",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "jmap",
    "email",
    "calendar",
    "contacts",
    "sieve",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

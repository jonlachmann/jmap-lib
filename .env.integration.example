# Copy this file to .env.integration and fill in your server details.

JMAP_BASE_URL=https://your-server.example
JMAP_USERNAME=your-username
JMAP_PASSWORD=your-password
# Optional if session discovery cannot resolve the account automatically.
# JMAP_ACCOUNT_ID=your-account-id

